# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Secrets de production générés localement — ne doivent jamais être versionnés.
secrets-production.txt

# Sauvegardes locales produites par `npm run sauvegarde` : contiennent des données
# personnelles, ne doivent jamais être versionnées.
/sauvegardes/

# Pièces jointes déposées : DONNÉES PERSONNELLES. Ne doivent jamais entrer dans git —
# un historique ne se purge pas.
/storage/
