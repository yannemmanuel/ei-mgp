# Connexion PostgreSQL — MÊME base que l'application Laravel de référence pendant la migration.
#
# ⚠️ Cette base est partagée avec Laravel encore en service : n'exécuter QUE `prisma db pull`
#    (lecture seule). Jamais `prisma migrate dev`, `migrate reset` ni `db push`.
#
# Doit correspondre aux DB_* du fichier .env de Laravel, à la racine du dépôt.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:5432/ei_mgp?schema=public"

# Secret de signature des jetons de session Auth.js.
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL publique de l'application. Auth.js v5 refuse toute requete dont l'en-tete Host ne
# correspond pas (protection contre l'injection d'en-tete Host) : sans cette variable, les
# routes /api/auth/* repondent UntrustedHost en production.
AUTH_URL="http://localhost:3000"
