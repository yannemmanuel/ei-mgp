# Connexion PostgreSQL.
#
# ⚠️ N'EXÉCUTER QUE `prisma db pull`. Jamais `prisma migrate dev`, `migrate reset` ni `db push`.
#
#    La règle vient d'une contrainte qui n'existe plus — la base était partagée avec une seconde
#    application — mais elle tient toujours, et pour une meilleure raison : `migrate reset`
#    PROPOSE D'EFFACER la base, et cette base porte des déclarations réelles. Le schéma évolue
#    par les fichiers SQL de `prisma/evolutions/`, appliqués à la main puis récupérés par
#    `db pull`.
# Sur Neon, utilisez la chaîne POOLED (hôte en `-pooler`) : chaque fonction serverless ouvre sa
# propre connexion, et le point d'entrée direct s'épuiserait. Terminez par `?sslmode=require`.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:5432/ei_mgp?schema=public"

# Secret de signature des jetons de session Auth.js.
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL publique de l'application. Auth.js v5 refuse toute requete dont l'en-tete Host ne
# correspond pas (protection contre l'injection d'en-tete Host) : sans cette variable, les
# routes /api/auth/* repondent UntrustedHost en production.
AUTH_URL="http://localhost:3000"

# À activer uniquement derrière un reverse proxy qui SUPPRIME puis reconstruit X-Forwarded-For
# et X-Real-IP. Sur Netlify, l'en-tête dédié est détecté automatiquement.
TRUST_PROXY_HEADERS="false"

# Secret partagé du déclencheur des tâches planifiées (POST /api/taches/{nom}).
# Next.js n'a pas d'ordonnanceur : un cron EXTERNE appelle cette route. 32 caractères minimum —
# en dessous, la route refuse tout et les tâches ne partent jamais.
TACHES_SECRET=""

# Transport e-mail Resend (recommandé). RESEND_FROM doit utiliser un domaine vérifié dans Resend,
# par exemple « Plateforme EI/MGP <notifications@votre-domaine.ci> ».
RESEND_API_KEY=""
RESEND_FROM=""

# SMTP générique de secours. Utilisé seulement si Resend n'est pas configuré. En production,
# l'application échoue fermée plutôt que de placer des liens d'accès dans les journaux.
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM=""

# Stockage des pièces jointes : `local` (disque) ou `blobs` (Netlify Blobs). À défaut, la
# présence de NETLIFY décide — écrire sur disque en serverless échouerait à la première
# déclaration comportant une pièce jointe.
STOCKAGE_RACINE="./storage/private"

STOCKAGE_MAGASIN=""
