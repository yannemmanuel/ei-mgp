generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model actions_correctives {
  id                       String          @id @db.Char(26)
  dossier_id               String          @db.Char(26)
  investigation_id         String?         @db.Char(26)
  intitule                 String          @db.VarChar(255)
  description              String
  responsable_id           BigInt?
  echeance                 DateTime        @db.Date
  statut                   String          @db.VarChar(255)
  verification_efficacite  Boolean?
  verification_commentaire String?
  date_cloture             DateTime?       @db.Timestamp(0)
  created_at               DateTime?       @db.Timestamp(0)
  updated_at               DateTime?       @db.Timestamp(0)
  responsable_nom          String?         @db.VarChar(255)
  dossiers                 dossiers        @relation(fields: [dossier_id], references: [id], onUpdate: NoAction, map: "actions_correctives_dossier_id_foreign")
  investigations           investigations? @relation(fields: [investigation_id], references: [id], onUpdate: NoAction, map: "actions_correctives_investigation_id_foreign")
  users                    users?          @relation(fields: [responsable_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "actions_correctives_responsable_id_foreign")

  @@index([dossier_id], map: "actions_correctives_dossier_id_index")
  @@index([echeance, statut], map: "actions_correctives_echeance_statut_index")
  @@index([investigation_id], map: "actions_correctives_investigation_id_index")
  @@index([responsable_id], map: "actions_correctives_responsable_id_index")
}

model audit_logs {
  id             BigInt   @id @default(autoincrement())
  user_id        BigInt?
  action         String   @db.VarChar(255)
  auditable_type String?  @db.VarChar(255)
  auditable_id   String?  @db.VarChar(255)
  old_values     Json?
  new_values     Json?
  ip_address     String?  @db.VarChar(255)
  user_agent     String?  @db.VarChar(255)
  url            String?  @db.VarChar(255)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  users          users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_id_foreign")

  @@index([auditable_type, auditable_id], map: "audit_logs_auditable_type_auditable_id_index")
  @@index([created_at], map: "audit_logs_created_at_index")
  @@index([user_id], map: "audit_logs_user_id_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model canaux_captage {
  id         BigInt     @id @default(autoincrement())
  code       String     @unique(map: "canaux_captage_code_unique") @db.VarChar(255)
  libelle    String     @db.VarChar(255)
  actif      Boolean    @default(true)
  created_at DateTime?  @db.Timestamp(0)
  updated_at DateTime?  @db.Timestamp(0)
  dossiers   dossiers[]
}

model categories {
  id                      BigInt                    @id @default(autoincrement())
  parcours_id             BigInt
  code                    String                    @db.VarChar(255)
  libelle                 String                    @db.VarChar(255)
  is_autre                Boolean                   @default(false)
  actif                   Boolean                   @default(true)
  ordre                   Int                       @default(0) @db.SmallInt
  created_at              DateTime?                 @db.Timestamp(0)
  updated_at              DateTime?                 @db.Timestamp(0)
  parcours                parcours                  @relation(fields: [parcours_id], references: [id], onUpdate: NoAction, map: "categories_parcours_id_foreign")
  dossiers                dossiers[]
  statistiques_mensuelles statistiques_mensuelles[]

  @@unique([parcours_id, code], map: "categories_parcours_id_code_unique")
}

model declaration_identites {
  id                   BigInt    @id @default(autoincrement())
  dossier_id           String    @unique(map: "declaration_identites_dossier_id_unique") @db.Char(26)
  nom_prenom           String?   @db.VarChar(255)
  matricule            String?   @db.VarChar(255)
  entreprise           String?   @db.VarChar(255)
  fonction             String?
  anciennete_annees    Int?      @db.SmallInt
  localite             String?
  statut_plaignant     String?   @db.VarChar(255)
  contact_email        String?   @db.VarChar(255)
  contact_telephone    String?   @db.VarChar(255)
  souhait_recontact    Boolean?
  canal_retour_prefere String?   @db.VarChar(255)
  personnes_impliquees String?
  temoins              String?
  consentement_rgpd    Boolean?
  created_at           DateTime? @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
  anciennete_tranche   String?
  dossiers             dossiers  @relation(fields: [dossier_id], references: [id], onUpdate: NoAction, map: "declaration_identites_dossier_id_foreign")
}

model directions {
  id                                                   BigInt     @id @default(autoincrement())
  code                                                 String     @unique(map: "directions_code_unique") @db.VarChar(255)
  libelle                                              String     @db.VarChar(255)
  actif                                                Boolean    @default(true)
  created_at                                           DateTime?  @db.Timestamp(0)
  updated_at                                           DateTime?  @db.Timestamp(0)
  site_id                                              BigInt?
  sites                                                sites?     @relation(fields: [site_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "directions_site_id_foreign")
  dossiers_dossiers_direction_declarant_idTodirections dossiers[] @relation("dossiers_direction_declarant_idTodirections")
  dossiers                                             dossiers[]
  postes                                               postes[]
  users                                                users[]

  @@index([site_id], map: "directions_site_id_index")
}

model dossier_affectations {
  id                                            BigInt    @id @default(autoincrement())
  dossier_id                                    String    @db.Char(26)
  user_id                                       BigInt
  affecte_par                                   BigInt?
  motif                                         String?
  type                                          String    @db.VarChar(255)
  actif                                         Boolean   @default(true)
  affecte_le                                    DateTime  @default(now()) @db.Timestamp(0)
  desaffecte_le                                 DateTime? @db.Timestamp(0)
  created_at                                    DateTime? @db.Timestamp(0)
  updated_at                                    DateTime? @db.Timestamp(0)
  users_dossier_affectations_affecte_parTousers users?    @relation("dossier_affectations_affecte_parTousers", fields: [affecte_par], references: [id], onUpdate: NoAction, map: "dossier_affectations_affecte_par_foreign")
  dossiers                                      dossiers  @relation(fields: [dossier_id], references: [id], onUpdate: NoAction, map: "dossier_affectations_dossier_id_foreign")
  users_dossier_affectations_user_idTousers     users     @relation("dossier_affectations_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction, map: "dossier_affectations_user_id_foreign")

  @@index([dossier_id, actif], map: "dossier_affectations_dossier_id_actif_index")
  @@index([user_id, actif], map: "dossier_affectations_user_id_actif_index")
  @@index([affecte_par], map: "dossier_affectations_affecte_par_index")
}

model dossiers {
  id                                                     String                 @id @db.Char(26)
  reference                                              String                 @unique(map: "dossiers_reference_unique") @db.VarChar(255)
  parcours_id                                            BigInt
  categorie_id                                           BigInt
  categorie_autre_precision                              String?
  niveau_gravite_id                                      BigInt?
  statut_id                                              BigInt
  canal_captage_id                                       BigInt
  is_anonymous                                           Boolean
  access_code_hash                                       String?                @db.VarChar(255)
  site_id                                                BigInt?
  direction_id                                           BigInt?
  declarant_user_id                                      BigInt?
  description                                            String
  lieu                                                   String?
  date_survenance                                        DateTime?              @db.Timestamp(0)
  attentes_declarant                                     String?
  synthese_resolution                                    String?
  motif_reouverture                                      String?
  motif_rejet                                            String?
  date_cloture                                           DateTime?              @db.Timestamp(0)
  created_at                                             DateTime?              @db.Timestamp(0)
  updated_at                                             DateTime?              @db.Timestamp(0)
  caractere_repetitif                                    String?                @db.VarChar(255)
  proposition_mesure_corrective                          String?
  contentieux                                            Boolean                @default(false)
  archive_le                                             DateTime?              @db.Timestamp(0)
  anonymise_le                                           DateTime?              @db.Timestamp(0)
  ville                                                  String?
  precision_localisation                                 String?
  entreprise                                             String?
  poste                                                  String?
  declarant_est_victime                                  Boolean?
  poste_precision                                        String?
  statut_plaignant                                       String?                @db.VarChar(255)
  statut_plaignant_precision                             String?
  direction_declarant_id                                 BigInt?
  poste_declarant                                        String?                @db.VarChar(255)
  poste_declarant_precision                              String?
  famille_risque_id                                      BigInt?
  actions_correctives                                    actions_correctives[]
  declaration_identites                                  declaration_identites?
  dossier_affectations                                   dossier_affectations[]
  canaux_captage                                         canaux_captage         @relation(fields: [canal_captage_id], references: [id], onUpdate: NoAction, map: "dossiers_canal_captage_id_foreign")
  categories                                             categories             @relation(fields: [categorie_id], references: [id], onUpdate: NoAction, map: "dossiers_categorie_id_foreign")
  users                                                  users?                 @relation(fields: [declarant_user_id], references: [id], onUpdate: NoAction, map: "dossiers_declarant_user_id_foreign")
  directions_dossiers_direction_declarant_idTodirections directions?            @relation("dossiers_direction_declarant_idTodirections", fields: [direction_declarant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dossiers_direction_declarant_id_foreign")
  directions                                             directions?            @relation(fields: [direction_id], references: [id], onUpdate: NoAction, map: "dossiers_direction_id_foreign")
  familles_risque                                        familles_risque?       @relation(fields: [famille_risque_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dossiers_famille_risque_id_foreign")
  niveaux_gravite                                        niveaux_gravite?       @relation(fields: [niveau_gravite_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "dossiers_niveau_gravite_id_foreign")
  parcours                                               parcours               @relation(fields: [parcours_id], references: [id], onUpdate: NoAction, map: "dossiers_parcours_id_foreign")
  sites                                                  sites?                 @relation(fields: [site_id], references: [id], onUpdate: NoAction, map: "dossiers_site_id_foreign")
  statuts_dossier                                        statuts_dossier        @relation(fields: [statut_id], references: [id], onUpdate: NoAction, map: "dossiers_statut_id_foreign")
  historique_statuts                                     historique_statuts[]
  investigations                                         investigations[]
  messages                                               messages[]

  @@index([created_at], map: "dossiers_created_at_index")
  @@index([niveau_gravite_id], map: "dossiers_niveau_gravite_id_index")
  @@index([parcours_id, statut_id], map: "dossiers_parcours_id_statut_id_index")
  @@index([direction_declarant_id], map: "dossiers_direction_declarant_id_index")
  @@index([famille_risque_id], map: "dossiers_famille_risque_id_index")
  @@index([canal_captage_id], map: "dossiers_canal_captage_id_index")
  @@index([categorie_id], map: "dossiers_categorie_id_index")
  @@index([declarant_user_id], map: "dossiers_declarant_user_id_index")
  @@index([direction_id], map: "dossiers_direction_id_index")
  @@index([site_id], map: "dossiers_site_id_index")
  @@index([statut_id], map: "dossiers_statut_id_index")
}

model historique_statuts {
  id                                                                      BigInt           @id @default(autoincrement())
  dossier_id                                                              String           @db.Char(26)
  statut_precedent_id                                                     BigInt?
  statut_suivant_id                                                       BigInt
  commentaire                                                             String?
  effectue_par                                                            BigInt?
  created_at                                                              DateTime         @default(now()) @db.Timestamp(0)
  dossiers                                                                dossiers         @relation(fields: [dossier_id], references: [id], onUpdate: NoAction, map: "historique_statuts_dossier_id_foreign")
  users                                                                   users?           @relation(fields: [effectue_par], references: [id], onUpdate: NoAction, map: "historique_statuts_effectue_par_foreign")
  statuts_dossier_historique_statuts_statut_precedent_idTostatuts_dossier statuts_dossier? @relation("historique_statuts_statut_precedent_idTostatuts_dossier", fields: [statut_precedent_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "historique_statuts_statut_precedent_id_foreign")
  statuts_dossier_historique_statuts_statut_suivant_idTostatuts_dossier   statuts_dossier  @relation("historique_statuts_statut_suivant_idTostatuts_dossier", fields: [statut_suivant_id], references: [id], onUpdate: NoAction, map: "historique_statuts_statut_suivant_id_foreign")

  @@index([dossier_id, created_at], map: "historique_statuts_dossier_id_created_at_index")
  @@index([effectue_par], map: "historique_statuts_effectue_par_index")
  @@index([statut_precedent_id], map: "historique_statuts_statut_precedent_id_index")
  @@index([statut_suivant_id], map: "historique_statuts_statut_suivant_id_index")
}

model investigations {
  id                                       String                @id @db.Char(26)
  dossier_id                               String                @db.Char(26)
  enqueteur_id                             BigInt
  date_ouverture                           DateTime              @db.Date
  faits_constates                          String
  personnes_rencontrees                    String?
  cause_immediate                          String?
  causes_racines                           String?
  recommandations                          String
  statut                                   String                @db.VarChar(255)
  valide_par                               BigInt?
  valide_le                                DateTime?             @db.Timestamp(0)
  created_at                               DateTime?             @db.Timestamp(0)
  updated_at                               DateTime?             @db.Timestamp(0)
  actions_correctives                      actions_correctives[]
  dossiers                                 dossiers              @relation(fields: [dossier_id], references: [id], onUpdate: NoAction, map: "investigations_dossier_id_foreign")
  users_investigations_enqueteur_idTousers users                 @relation("investigations_enqueteur_idTousers", fields: [enqueteur_id], references: [id], onUpdate: NoAction, map: "investigations_enqueteur_id_foreign")
  users_investigations_valide_parTousers   users?                @relation("investigations_valide_parTousers", fields: [valide_par], references: [id], onUpdate: NoAction, map: "investigations_valide_par_foreign")

  @@index([dossier_id], map: "investigations_dossier_id_index")
  @@index([enqueteur_id], map: "investigations_enqueteur_id_index")
  @@index([valide_par], map: "investigations_valide_par_index")
}

model messages {
  id                 String    @id @db.Char(26)
  dossier_id         String    @db.Char(26)
  expediteur_type    String    @db.VarChar(255)
  expediteur_user_id BigInt?
  corps              String
  lu_le              DateTime? @db.Timestamp(0)
  created_at         DateTime  @default(now()) @db.Timestamp(0)
  dossiers           dossiers  @relation(fields: [dossier_id], references: [id], onUpdate: NoAction, map: "messages_dossier_id_foreign")
  users              users?    @relation(fields: [expediteur_user_id], references: [id], onUpdate: NoAction, map: "messages_expediteur_user_id_foreign")

  @@index([dossier_id, created_at], map: "messages_dossier_id_created_at_index")
  @@index([expediteur_user_id], map: "messages_expediteur_user_id_index")
}

model model_has_permissions {
  permission_id BigInt
  model_type    String      @db.VarChar(255)
  model_id      BigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_permissions_permission_id_foreign")

  @@id([permission_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_permissions_model_id_model_type_index")
}

model model_has_roles {
  role_id    BigInt
  model_type String @db.VarChar(255)
  model_id   BigInt
  roles      roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_roles_role_id_foreign")

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model niveaux_gravite {
  id                      BigInt                    @id @default(autoincrement())
  niveau                  Int                       @unique(map: "niveaux_gravite_niveau_unique") @db.SmallInt
  code                    String                    @unique(map: "niveaux_gravite_code_unique") @db.VarChar(255)
  libelle                 String                    @db.VarChar(255)
  effet_circuit           String                    @db.VarChar(255)
  couleur                 String?                   @db.VarChar(255)
  actif                   Boolean                   @default(true)
  created_at              DateTime?                 @db.Timestamp(0)
  updated_at              DateTime?                 @db.Timestamp(0)
  dossiers                dossiers[]
  statistiques_mensuelles statistiques_mensuelles[]
}

model notification_templates {
  id                                  BigInt    @id @default(autoincrement())
  evenement_code                      String    @db.VarChar(255)
  parcours_id                         BigInt?
  canal                               String    @db.VarChar(255)
  objet                               String    @db.VarChar(255)
  corps                               String
  actif                               Boolean   @default(true)
  created_at                          DateTime? @db.Timestamp(0)
  updated_at                          DateTime? @db.Timestamp(0)
  destinataires_email_supplementaires Json?     @db.Json
  parcours                            parcours? @relation(fields: [parcours_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "notification_templates_parcours_id_foreign")

  @@index([parcours_id], map: "notification_templates_parcours_id_index")
}

model notifications {
  id              String    @id @db.Uuid
  type            String    @db.VarChar(255)
  notifiable_type String    @db.VarChar(255)
  notifiable_id   BigInt
  data            String
  read_at         DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([notifiable_type, notifiable_id], map: "notifications_notifiable_type_notifiable_id_index")
}

model parcours {
  id                      BigInt                    @id @default(autoincrement())
  code                    String                    @unique(map: "parcours_code_unique") @db.VarChar(255)
  libelle                 String                    @db.VarChar(255)
  actif                   Boolean                   @default(true)
  ordre                   Int                       @default(0) @db.SmallInt
  created_at              DateTime?                 @db.Timestamp(0)
  updated_at              DateTime?                 @db.Timestamp(0)
  familles_risque_actives Boolean                   @default(true)
  categories              categories[]
  dossiers                dossiers[]
  familles_risque         familles_risque[]
  notification_templates  notification_templates[]
  qr_codes                qr_codes[]
  role_etapes             role_etapes[]
  role_parcours           role_parcours[]
  sla_delais              sla_delais[]
  statistiques_mensuelles statistiques_mensuelles[]
  utilisateur_parcours    utilisateur_parcours[]
}

model permissions {
  id                    BigInt                  @id @default(autoincrement())
  name                  String                  @unique(map: "permissions_name_unique") @db.VarChar(255)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  model_has_permissions model_has_permissions[]
  role_has_permissions  role_has_permissions[]
}

model pieces_jointes {
  id              String   @id @db.Char(26)
  attachable_type String   @db.VarChar(255)
  attachable_id   String   @db.Char(26)
  disque          String   @db.VarChar(255)
  chemin          String   @db.VarChar(255)
  nom_original    String   @db.VarChar(255)
  mime_type       String   @db.VarChar(255)
  taille_octets   BigInt
  checksum_sha256 String   @db.VarChar(255)
  televerse_par   BigInt?
  created_at      DateTime @default(now()) @db.Timestamp(0)
  users           users?   @relation(fields: [televerse_par], references: [id], onUpdate: NoAction, map: "pieces_jointes_televerse_par_foreign")

  @@index([attachable_type, attachable_id], map: "pieces_jointes_attachable_type_attachable_id_index")
  @@index([televerse_par], map: "pieces_jointes_televerse_par_index")
}

model qr_codes {
  id           String    @id @db.Char(26)
  parcours_id  BigInt
  token        String    @unique(map: "qr_codes_token_unique") @db.VarChar(255)
  url_cible    String
  actif        Boolean   @default(true)
  genere_par   BigInt?
  genere_le    DateTime  @default(now()) @db.Timestamp(0)
  desactive_le DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  users        users?    @relation(fields: [genere_par], references: [id], onUpdate: NoAction, map: "qr_codes_genere_par_foreign")
  parcours     parcours  @relation(fields: [parcours_id], references: [id], onUpdate: NoAction, map: "qr_codes_parcours_id_foreign")

  @@index([genere_par], map: "qr_codes_genere_par_index")
  @@index([parcours_id], map: "qr_codes_parcours_id_index")
}

model role_has_permissions {
  permission_id BigInt
  role_id       BigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_permission_id_foreign")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_role_id_foreign")

  @@id([permission_id, role_id])
  @@index([role_id], map: "role_has_permissions_role_id_index")
}

model roles {
  id                              BigInt                 @id @default(autoincrement())
  name                            String                 @unique(map: "roles_name_unique") @db.VarChar(255)
  created_at                      DateTime?              @db.Timestamp(0)
  updated_at                      DateTime?              @db.Timestamp(0)
  libelle                         String                 @db.VarChar(255)
  description                     String?
  actif                           Boolean                @default(true)
  traite_dossiers                 Boolean                @default(false)
  cloisonne_par_rattachement      Boolean                @default(false)
  voit_seulement_ses_declarations Boolean                @default(false)
  voit_identite_declarant         Boolean                @default(true)
  model_has_roles                 model_has_roles[]
  role_etapes                     role_etapes[]
  role_has_permissions            role_has_permissions[]
  role_parcours                   role_parcours[]
}

model sites {
  id         BigInt       @id @default(autoincrement())
  code       String       @unique(map: "sites_code_unique") @db.VarChar(255)
  libelle    String       @db.VarChar(255)
  actif      Boolean      @default(true)
  created_at DateTime?    @db.Timestamp(0)
  updated_at DateTime?    @db.Timestamp(0)
  directions directions[]
  dossiers   dossiers[]
  users      users[]
}

model sla_delais {
  id                BigInt    @id @default(autoincrement())
  parcours_id       BigInt
  etape_code        String    @db.VarChar(255)
  valeur            Int
  unite             String    @db.VarChar(255)
  est_valide_metier Boolean   @default(false)
  notes             String?
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  parcours          parcours  @relation(fields: [parcours_id], references: [id], onUpdate: NoAction, map: "sla_delais_parcours_id_foreign")

  @@unique([parcours_id, etape_code], map: "sla_delais_parcours_id_etape_code_unique")
}

model statistiques_mensuelles {
  id                BigInt           @id @default(autoincrement())
  periode           DateTime         @db.Date
  parcours_id       BigInt?
  categorie_id      BigInt?
  niveau_gravite_id BigInt?
